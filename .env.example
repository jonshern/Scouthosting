# Copy to .env for local dev. Never commit .env.

# Postgres connection used by Prisma + the app at runtime.
DATABASE_URL="postgresql://compass:compass@localhost:5432/compass?schema=public"

NODE_ENV=development

# Apex host (no port). Subdomains of this become tenant sites.
APEX_HOST=localhost

# Cookie domain (with leading dot in prod, e.g. .compass.app) so a session
# set on the apex stays valid on every tenant subdomain. Leave blank in
# dev — most browsers handle *.localhost correctly without it.
COOKIE_DOMAIN=

# Random hex used to sign one-shot tokens (RSVP, invites, unsubs, etc.).
# Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-not-secret-replace-in-prod-0123456789abcdef"

# Permits password sign-in for admin/super-admin in non-production builds
# only. Production refuses unless explicitly set to "1" — and you should
# never set that in production.
ALLOW_ADMIN_PASSWORD_LOGIN=

# Master encryption key for per-org envelope encryption (Member PII +
# photo bytes). 32 bytes hex. Generate with: openssl rand -hex 32
# Leave blank in dev/test to fall back to a per-process ephemeral key
# (warns to stderr); REQUIRED in production. `make bootstrap` will
# generate one for you if .env is missing this line.
MASTER_KEY=

# Which request header carries the real client IP (rate limiting).
# Auto-detected: Fly.io → fly-client-ip, Cloud Run → x-forwarded-for.
# Set it explicitly behind any other proxy (e.g. cf-connecting-ip). For
# x-forwarded-for, CLIENT_IP_XFF_HOPS picks the entry N from the right
# (1 = the hop our own proxy appended; 2 behind an extra load balancer).
# Unset in dev: no IP is trusted and per-IP limits are skipped.
CLIENT_IP_HEADER=
CLIENT_IP_XFF_HOPS=
