# Copy to .env for local dev. Never commit .env.

# Postgres connection used by Prisma + the app at runtime.
DATABASE_URL="postgresql://compass:compass@localhost:5433/compass?schema=public"

NODE_ENV=development

# Apex host (no port). Subdomains of this become tenant sites.
APEX_HOST=localhost

# Cookie domain (with leading dot in prod, e.g. .compass.app) so a session
# set on the apex stays valid on every tenant subdomain. Leave blank in
# dev — most browsers handle *.localhost correctly without it.
COOKIE_DOMAIN=

# Random hex used to sign one-shot tokens (RSVP, invites, unsubs, etc.).
# Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-not-secret-replace-in-prod-0123456789abcdef"

# Better Auth signs session cookies with BETTER_AUTH_SECRET if set,
# otherwise SESSION_SECRET. Production refuses to boot without one
# (32+ characters).
BETTER_AUTH_SECRET=

# Optional per-link signing keys (32+ characters each). Each falls back
# to SESSION_SECRET, then BETTER_AUTH_SECRET. In production a link with
# no key at all is refused, never signed with a built-in one
# (src/lib/security/link-secret.ts). Changing a key breaks the links
# already sent with it.
# RSVP links; also the next fallback for the three below it.
RSVP_SECRET=
# Permission-slip signing links.
PERM_SLIP_SECRET=
# Unsubscribe links (valid 10 years, so rotate carefully).
UNSUB_SECRET=
# Unit invite links (AUTH_TOKEN_SECRET is an older name for it).
INVITE_SECRET=
# Email click-tracking links (does not fall back to RSVP_SECRET).
TRACKING_SECRET=

# Permits password sign-in for admin/super-admin in non-production builds
# only. Production refuses unless explicitly set to "1" — and you should
# never set that in production.
ALLOW_ADMIN_PASSWORD_LOGIN=

# Leaders, admins and super-admins must turn on two-step sign-in before
# the admin pages or the mobile app work for them (production only).
# "1" skips that for staging / QA. Never set it in production.
ALLOW_ADMIN_WITHOUT_MFA=

# Master encryption key for per-org envelope encryption (Member PII +
# photo bytes). 32 bytes hex. Generate with: openssl rand -hex 32
# Leave blank in dev/test to fall back to a per-process ephemeral key
# (warns to stderr); REQUIRED in production. `make bootstrap` will
# generate one for you if .env is missing this line.
MASTER_KEY=

# Which request header carries the real client IP (rate limiting).
# Auto-detected on Cloud Run (K_SERVICE set) → x-forwarded-for.
# Set it explicitly behind any other proxy (e.g. cf-connecting-ip). For
# x-forwarded-for, CLIENT_IP_XFF_HOPS picks the entry N from the right
# (1 = the hop our own proxy appended; 2 behind an extra load balancer).
# Unset in dev: the rightmost X-Forwarded-For hop is used. Unset in
# production off Cloud Run: no IP is trusted (per-IP limits skipped).
# TRUSTED_IP_HEADER / TRUSTED_PROXY_HOPS are accepted as aliases.
CLIENT_IP_HEADER=
CLIENT_IP_XFF_HOPS=

# Public demo (docs/demo.md). "1" turns this whole deployment into the
# demo: sample Troop 42 with shared accounts, a banner on every page,
# every email and text kept in /demo/outbox, sign-up and password /
# two-step changes off, and a wipe-and-reseed every DEMO_RESET_HOURS
# (default 24). Give it its own database; never set it on a deployment
# that holds real units. `make demo` sets it for you.
DEMO_MODE=
DEMO_RESET_HOURS=

# Claude connector (docs/mcp.md). The public origin Claude reaches
# Compass on; tokens are bound to <origin>/mcp. Defaults to
# https://<APEX_HOST>. https only, except localhost.
MCP_PUBLIC_URL=
# Path to the requirement catalog (scout-core
# packages/catalog/dist/catalog.json). Without it the connector can't
# name requirements or say what's left.
CATALOG_PATH=
