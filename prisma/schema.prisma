// Scouthosting database schema.
//
// Single Postgres database, single schema. Tenant isolation is enforced at
// the application layer via the `orgId` column on every org-scoped table.
//
// Deferred (tracked as [security] items in ROADMAP.md):
//   - Postgres Row-Level Security policies on org-scoped tables
//   - Per-tenant encryption keys
//   - Field-level encryption for sensitive PII (medical, contact info)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Control plane
// ------------------------------------------------------------------

enum UnitType {
  Troop // Scouts BSA Troop (formerly Boy Scouts)
  Pack // Cub Scout Pack
  Crew // Venturing Crew
  Ship // Sea Scout Ship
  Post // Exploring Post
  GirlScoutTroop // Girl Scouts of the USA Troop (separate organisation
  // from Scouts BSA — different program, different vocab)
}

enum Plan {
  patrol
  troop
  council
}

// Stripe subscription state, snapshotted from webhook events. `trialing`
// is the default for a freshly-provisioned org (60-day trial set in
// provision.js); `expired` is the post-trial state when the org never
// converted (distinct from `canceled`, which means they had a paid
// subscription and stopped).
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum Role {
  scout
  parent
  leader
  admin
}

model Org {
  id                            String             @id @default(cuid())
  slug                          String             @unique
  unitType                      UnitType
  unitNumber                    String
  displayName                   String
  tagline                       String?
  charterOrg                    String
  city                          String
  state                         String
  council                       String?
  district                      String?
  founded                       String?
  meetingDay                    String             @default("Mondays")
  meetingTime                   String             @default("7:00 PM")
  meetingLocation               String?
  scoutmasterName               String
  scoutmasterEmail              String
  committeeChairEmail           String?
  // Workspace-style ownership. Single User who holds plan/billing/delete
  // authority on this org — the Slack "primary owner" / GitHub "owner"
  // analogue. Distinct from OrgMembership.role: an owner also holds an
  // admin membership row, so existing requireLeader gates pass for them
  // unchanged. requireOwner gates the narrow set of actions that should
  // only fire for the founding scoutmaster: change plan, delete org,
  // transfer ownership. Backfilled from scoutmasterEmail at migration
  // time; nullable because the founder might be deleted before transfer.
  ownerId                       String?
  primaryColor                  String             @default("#1d6b39")
  accentColor                   String             @default("#caa54a")
  // Per-org logo. Filename in the same per-org storage area as Photos
  // (lib/storage.js). null = use the default brand mark (unit number).
  logoFilename                  String?
  plan                          Plan               @default(patrol)
  isDemo                        Boolean            @default(false)
  customDomain                  String?            @unique
  // Per-org feature flags. Map of feature key → boolean (or any JSON
  // value for richer config). Read via lib/featureFlags.js so unknown
  // flags get sensible defaults. Toggled from /__super (super-admin
  // console) — leaders don't edit this directly.
  features                      Json?
  // À-la-carte add-ons orthogonal to the plan tier. JSON array of
  // string keys (e.g. ["messaging"]). Add-ons unlock specific feature
  // bundles (DMs, broadcast email/SMS, channels, newsletters) and are
  // billed separately from the base subscription. Demo orgs bypass.
  // Self-serve enable/disable lands in a follow-up; for now a super-
  // admin sets the array.
  addOns                        Json?
  // Suspended orgs are read-only: no admin login, no API writes, the
  // public site still renders. Used for non-payment / abuse holds.
  // suspendedReason renders on the (still-public) homepage so members
  // know to nudge their charter org.
  suspendedAt                   DateTime?
  suspendedReason               String?
  // Stripe billing state. Webhook events (lib/stripe.js) are the single
  // writer for these fields — admin UI reads them but never mutates them
  // directly. `subscriptionStatus` is the gate for plan enforcement
  // (lib/billingState.js). A null `stripeCustomerId` is fine: the org is
  // either pre-checkout (still trialing) or grandfathered.
  stripeCustomerId              String?            @unique
  stripeSubscriptionId          String?            @unique
  stripePriceId                 String?
  subscriptionStatus            SubscriptionStatus @default(trialing)
  trialEndsAt                   DateTime?
  currentPeriodEnd              DateTime?
  cancelAtPeriodEnd             Boolean            @default(false)
  // Treasury Stripe (per-org member-payment account, distinct from
  // the platform billing fields above). Both ciphertexts are wrapped
  // with the org's DEK so the master key alone can't decrypt them.
  treasuryStripeKeyCt           Bytes?
  treasuryStripeWebhookSecretCt Bytes?
  treasuryStripeKeyPrefix       String?
  treasuryStripeAccountLabel    String?
  // Per-org envelope encryption. The Data Encryption Key (DEK) is a
  // 32-byte AES-256 key, generated at provisioning. It is wrapped
  // three independent ways so the same DEK can be unlocked by any of:
  //   - encryptedDek          → MASTER_KEY env var (server's daily use)
  //   - passphraseWrappedDek  → admin-chosen passphrase (break-glass + rotation)
  //   - recoveryWrappedDek    → server-generated recovery code shown ONCE
  // Verifier hashes let us reject wrong inputs without unwrapping.
  // See src/lib/encryption/vault.ts.
  encryptedDek                  Bytes?
  passphraseWrappedDek          Bytes?
  passphraseSalt                Bytes?
  passphraseVerifier            String?
  recoveryWrappedDek            Bytes?
  recoverySalt                  Bytes?
  recoveryVerifier              String?
  keyVersion                    Int                @default(0)
  keyRotatedAt                  DateTime?
  recoveryAcknowledgedAt        DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  memberships          OrgMembership[]
  members              Member[]
  events               Event[]
  photos               Photo[]
  albums               Album[]
  forms                Form[]
  page                 Page?
  announcements        Announcement[]
  posts                Post[]
  comments             Comment[]
  rsvps                Rsvp[]
  slots                SignupSlot[]
  slotAssignments      SlotAssignment[]
  tripPlans            TripPlan[]
  meals                Meal[]
  ingredients          Ingredient[]
  gear                 GearItem[]
  equipment            Equipment[]
  customPages          CustomPage[]
  surveys              Survey[]
  pageVersions         PageVersion[]
  eventCategories      EventCategory[]
  eagleScouts          EagleScout[]
  eagleProjects        EagleProject[]
  cohAwards            CohAward[]
  positionTerms        PositionTerm[]
  trainings            Training[]
  auditLogs            AuditLog[]
  carRides             CarRide[]
  carRideRiders        CarRideRider[]
  meritBadgeCounselors MeritBadgeCounselor[]
  reimbursements       Reimbursement[]
  oaElections          OaElection[]
  oaCandidates         OaCandidate[]
  videos               Video[]
  newsletters          Newsletter[]
  channels             Channel[]
  supportTickets       SupportTicket[]
  refunds              Refund[]
  feedbackRequests     FeedbackRequest[]
  newsletterSchedule   NewsletterSchedule?
  newsletterRules      NewsletterRule[]
  errorLogs            ErrorLog[]
  permissionSlips      PermissionSlip[]
  equipmentLoans       EquipmentLoan[]
  funds                Fund[]
  fiscalYears          FiscalYear[]
  fundBudgets          FundBudget[]
  transactions         Transaction[]
  bankImports          BankImport[]
  locations            Location[]
  patrols              Patrol[]
  memberSubaccounts    MemberSubaccount[]
  scoutbookConnection  ScoutbookConnection?
  scoutbookProfiles    ScoutbookProfile[]
  scoutbookSyncRuns    ScoutbookSyncRun[]
  salesCampaigns       SalesCampaign[]
  salesOrders          SalesOrder[]
  boothSales           BoothSale[]
  eventStaff           EventStaff[]
  counselorAssignments CounselorAssignment[]
  requirementProgress  RequirementProgress[]
  requirementEvents    RequirementProgressEvent[]
  counselorMeetings    CounselorMeeting[]
  owner                User?                      @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([plan])
  @@index([ownerId])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  displayName        String
  emailVerified      Boolean   @default(false)
  // Profile picture URL from Google/Apple. Better Auth's user model
  // expects the column; Compass doesn't render it yet.
  image              String?
  // Compass operator. Bypasses all per-org auth, sees the super-admin
  // console at /__super on the apex. Set manually in the DB or via the
  // CLI; never granted from any HTTP form.
  isSuperAdmin       Boolean   @default(false)
  // Last time the weekly DM digest was sent to this user. Set by the
  // dmDigestCron sweep; null means never digested. Drives the 7-day
  // cadence: a user is eligible for a fresh digest only when they
  // have unread DMs older than 24h AND their last digest was 7+
  // days ago (or never).
  lastDmDigestSentAt DateTime?
  // TOTP-based 2FA. totpSecret is a base32-encoded shared secret
  // generated at enrollment; null means MFA is not set up. Stored
  // plaintext (acceptable v1; future PR adds env-var-keyed AEAD).
  // totpEnrolledAt fires on the first successful verify and is the
  // canonical "MFA active" check. totpLastUsedAt is set on every
  // successful TOTP verify and used to reject same-window replay.
  totpSecret         String?
  totpEnrolledAt     DateTime?
  totpLastUsedAt     DateTime?
  // When the user confirmed they are 18 or older. Every new sign-up
  // (password or Google/Apple) must confirm before using the app;
  // accounts that existed before the policy were backfilled.
  adultAttestedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions              Session[]
  memberships           OrgMembership[]
  announcements         Announcement[]
  posts                 Post[]
  comments              Comment[]
  accounts              Account[]
  passkeys              Passkey[]
  rsvps                 Rsvp[]
  slotAssignments       SlotAssignment[]
  newsletters           Newsletter[]
  apiTokens             ApiToken[]
  channelMemberships    ChannelMember[]
  messages              Message[]
  reactions             Reaction[]
  uploadedPhotos        Photo[]
  pushDevices           PushDevice[]
  postReactions         PostReaction[]
  feedbackRequests      FeedbackRequest[]
  feedbackVotes         FeedbackVote[]
  feedbackComments      FeedbackComment[]
  ownedOrgs             Org[]                 @relation("OrgOwner")
  backupCodes           BackupCode[]
  errorLogs             ErrorLog[]
  publishedPageVersions PageVersion[]
  eventStaff            EventStaff[]
  counselorBadges       CounselorBadge[]
  counselorAssignments  CounselorAssignment[] @relation("AssignedCounselor")
  counselorMeetings     CounselorMeeting[]
}

// One-time-use 2FA backup codes. Generated at enrollment (10 per user),
// shown to the user once on a "save these somewhere safe" screen, and
// consumed on use. Codes are argon2id-hashed at rest with the same
// params as passwords (lib/auth.js). usedAt non-null = consumed.
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sign-in methods for a User, owned by Better Auth (src/lib/auth/auth.ts).
// providerId "credential" holds the argon2id password hash in `password`
// with accountId = userId. "google" / "apple" rows carry the provider's
// stable subject id in accountId; one User can have several, but only
// one per (providerId, accountId).
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// A WebAuthn passkey (src/lib/auth/passkeys.ts). credentialId is the
// authenticator's id, base64url. rpId is the relying party it was made
// for: the apex for the apex and every <slug> subdomain, or an org's
// custom domain. A passkey only works on hosts with the same rpId.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  name         String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String
  backedUp     Boolean   @default(false)
  rpId         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived Better Auth values: OAuth state, email-verification
// tokens, MFA sign-in challenges. Rows expire on their own.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Better Auth's rate-limit counters. Kept in Postgres so the limits hold
// across instances and restarts.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// A user can belong to many orgs (parent with kids in two units, leader
// who serves at council level, etc.). Each membership has a role within
// that org.
model OrgMembership {
  id              String    @id @default(cuid())
  userId          String
  orgId           String
  role            Role      @default(parent)
  // YPT (Youth Protection Training) status. A leader/admin is "current"
  // if yptCurrentUntil is in the future. Drives the two-deep guard on
  // every chat-channel write where youth are present.
  // Leader-entered for v1 (CSV import / manual edit). The BSA training
  // roster scrape is a separate fight.
  yptCurrentUntil DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  id        String   @id @default(cuid())
  // The value carried (HMAC-signed) in the compass_session cookie.
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Org-scoped data (every row carries orgId)
// ------------------------------------------------------------------

model Member {
  id                String    @id @default(cuid())
  orgId             String
  // PII fields encrypted with the org's DEK (see Org.encryptedDek).
  // Layout is iv|tag|ciphertext, AES-256-GCM, AAD bound to org+purpose.
  // Nullable for migration ergonomics; the application layer treats
  // first/last name as effectively required at write time (seed +
  // upsertMember always populate them). See
  // src/lib/encryption/field.ts and src/lib/members/crypto.ts.
  encFirstName      Bytes?
  encLastName       Bytes?
  encPhone          Bytes?
  encStreet         Bytes?
  encCity           Bytes?
  encState          Bytes?
  encZip            Bytes?
  // Sort/filter helper. First lowercased character of last name. Indexed
  // so the roster page can do a stable initial sort + bucket-prefix
  // search without needing the DEK. Only one character of entropy
  // leaks; precise alphabetical order is restored in JS after decrypt.
  lastNameLc1       String    @default("?")
  // Email stays plaintext on purpose: background email sends, magic
  // links, and chat-channel membership lookups all need to query by
  // exact email value without unlocking a vault.
  email             String?
  // Drives which channel a broadcast targets this member on.
  // email: send email only
  // sms:   send SMS only (requires phone + smsOptIn)
  // both:  send both
  // none:  do not contact (still appears in the directory)
  commPreference    String    @default("email")
  smsOptIn          Boolean   @default(false)
  patrol            String?
  position          String? // SPL, ASPL, Patrol Leader, Scoutmaster, etc.
  joinedAt          DateTime  @default(now())
  birthdate         DateTime?
  isYouth           Boolean   @default(true)
  dietaryFlags      String[]  @default([]) // e.g. ["vegetarian", "gluten-free"]
  // Optional roster fields surfaced by the /admin/reports views.
  // shirtSize is a free-form string ("YL", "AM", "AXL") so we don't
  // have to hard-code every BSA/Scouts vendor sizing chart.
  shirtSize         String?
  notes             String?
  // Scoutbook link — Scoutbook user id lets admins jump from the
  // member directory to that Scout's Scoutbook record. We don't store
  // any advancement data; that lives in Scoutbook.
  scoutbookUserId   String?
  // Family linkage. Each row points to its parent Members (typically the
  // youth's mom/dad/guardian); the inverse relation gives parents their
  // children. Postgres array of Member IDs keeps schema simple — no join
  // table needed for v1. Filter at query time.
  parentIds         String[]  @default([])
  // Recipient-level unsubscribe. Set when the member clicks the
  // unsubscribe link in a broadcast (or hits the one-click List-Unsubscribe
  // header). Filters them out of audienceFor regardless of commPreference.
  emailUnsubscribed Boolean   @default(false)
  unsubscribedAt    DateTime?
  // Set when a bounce or complaint webhook arrives from the mail
  // provider (Resend today). When non-null, audienceFor also drops
  // this member from the email channel — even if emailUnsubscribed
  // is false. The reason field carries the provider's classification
  // (e.g. "bounced:hard", "complained") so a leader can decide
  // whether to chase a corrected address.
  bouncedAt         DateTime?
  bounceReason      String?
  // Free-form roster lookups: "who has WFA?", "who can drive a 15-passenger
  // van?", "who plays a guitar for campfires?". Lowercased on save for
  // dedupe; display preserves first-seen casing.
  skills            String[]  @default([])
  interests         String[]  @default([])
  // Lifecycle status — drives /admin/leads vs /admin/members visibility.
  //   prospect — interested but not yet registered with the council
  //              (a "lead" — appears on /admin/leads, hidden from
  //              the default roster filter)
  //   active   — registered roster member (default)
  //   alumni   — past member, kept for history but excluded from
  //              broadcasts and from the default member list
  status            String    @default("active")
  // Lead-tracking metadata. All null for status="active"/"alumni"; a
  // lead admin populates them as the prospect moves through the funnel.
  prospectSource    String? // "web-form" | "walk-up" | "referral" | "other"
  prospectNote      String? // free-form: what grade is the kid? what unit are they coming from?
  firstContactedAt  DateTime? // set on first /admin/leads "Mark contacted" or send
  lastContactedAt   DateTime? // updated on every contact event
  // When status last became "alumni" (left the unit). Cleared if they
  // come back. The youth retention sweep deletes a scout's records 18
  // months after this (src/lib/retention/scouts.ts).
  leftAt            DateTime?
  // Soft delete. /admin/members "Remove" sets this; the row stays in
  // place so parent linkages, audit history, and contributed content
  // (posts/comments/photos) keep their attribution. /admin/members/
  // trash lets a leader restore (clear deletedAt) or permanently
  // purge. A cron sweep hard-deletes rows whose deletedAt is older
  // than 30 days.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org                  Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rsvps                Rsvp[]
  positionTerms        PositionTerm[]
  trainings            Training[]
  meritBadgeCounselors MeritBadgeCounselor[]
  oaCandidacies        OaCandidate[]
  permissionSlips      PermissionSlip[]
  equipmentLoans       EquipmentLoan[]
  subaccount           MemberSubaccount?
  transactions         Transaction[]
  scoutbookProfile     ScoutbookProfile?
  salesOrders          SalesOrder[]
  scoutSalesLinks      ScoutSalesLink[]
  patrolsLed           Patrol[]                   @relation("PatrolLeader")
  counselorAssignments CounselorAssignment[]
  requirementProgress  RequirementProgress[]
  requirementEvents    RequirementProgressEvent[]
  counselorMeetings    CounselorMeetingScout[]

  @@index([orgId])
  @@index([orgId, lastNameLc1])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  // "My scouts" finds a parent's roster entries across units by email.
  @@index([email])
}

model Event {
  id                     String    @id @default(cuid())
  orgId                  String
  title                  String
  description            String?
  startsAt               DateTime
  endsAt                 DateTime?
  allDay                 Boolean   @default(false)
  location               String?
  // For map links: stored verbatim and used to build Google/Apple/Waze URLs
  // at render time. Free-form fallback when locationId is null.
  locationAddress        String?
  // Optional first-class link to a saved Location entry. When set,
  // the leader's quick map / location autocomplete uses the saved
  // entry; the free-form `location` + `locationAddress` fields above
  // remain populated for back-compat / public ICS feeds.
  locationId             String?
  cost                   Int? // dollars
  capacity               Int?
  signupRequired         Boolean   @default(false)
  // Public sign-up address for apps outside Compass (Waypoint's badge
  // day pages): POST /api/events/<publicSlug>/signups. Null = not
  // open to public sign-ups. Globally unique, so no org is needed.
  publicSlug             String?   @unique
  category               String? // meeting, campout, service, court-of-honor...
  // RFC 5545 RRULE without the leading "RRULE:" prefix. Null = single
  // occurrence. Examples: "FREQ=WEEKLY;BYDAY=MO" (every Monday),
  // "FREQ=MONTHLY;BYDAY=1TU" (first Tuesday of every month).
  rrule                  String?
  recurrenceUntil        DateTime?
  // Per-attendee credits this event grants. A 2-night campout sets
  // campingNights = 2; a service project sets serviceHours = 4. Every
  // member with a "yes" RSVP earns the credits when /admin/credits
  // computes totals. null/0 means the event doesn't grant that credit.
  serviceHours           Float?
  campingNights          Int?
  hikingMiles            Float?
  // When true, every yes-RSVP youth needs an electronic permission
  // slip on file before the event. The text below is the consent
  // language a parent agrees to when they sign; defaults to a generic
  // BSA-style statement at render time. A signed slip is captured by
  // the PermissionSlip model with the parent's typed name, IP, and
  // a snapshot of slipText so future edits don't retroactively
  // change what the parent agreed to.
  requiresPermissionSlip Boolean   @default(false)
  permissionSlipText     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rsvps           Rsvp[]
  slots           SignupSlot[]
  plan            TripPlan?
  cohAwards       CohAward[]
  rides           CarRide[]
  reimbursements  Reimbursement[]
  channels        Channel[]
  staff           EventStaff[]
  permissionSlips PermissionSlip[]
  transactions    Transaction[]
  locationRef     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orgId, startsAt])
  @@index([orgId, locationId])
}

// A sign-up "slot" is a discrete thing for an event that needs a person
// (or N people): drivers, food items to bring, gear to provide. Unlike
// RSVPs (one-per-person, yes/no/maybe), slots are tied to specific tasks.
model SignupSlot {
  id            String   @id @default(cuid())
  orgId         String
  eventId       String
  title         String // "Bring drinks for 30", "Drive 2 scouts"
  description   String?
  capacity      Int      @default(1)
  // When a slot fills, additional sign-ups join a waitlist (ordered by
  // createdAt). The oldest waitlister auto-promotes when an active
  // assignment is released. Leaders can disable per-slot.
  allowWaitlist Boolean  @default(true)
  sortOrder     Int      @default(0)
  // Stable external id, so an outside event file can address the slot:
  // "station:<stationId>" or "role:<volunteerRoleId>" for Waypoint.
  key           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments SlotAssignment[]
  staff       EventStaff[]
  channels    Channel[]

  @@unique([eventId, key])
  @@index([orgId, eventId, sortOrder])
}

model SlotAssignment {
  id         String   @id @default(cuid())
  orgId      String
  slotId     String
  userId     String? // signed-in user (preferred path)
  name       String
  email      String?
  // Public sign-ups: the scout this seat is for, first name + last
  // initial only (youth protection). "" when the signer is the
  // attendee (drivers, volunteers, signed-in members), so one parent
  // can hold a seat per scout while (slot, email) stays deduped.
  scoutName  String   @default("")
  // Guardian's phone, optional, from public sign-ups.
  phone      String?
  notes      String?
  // True while the assignment is queued behind a full slot. When an
  // active assignment is released, the oldest waitlisted row is
  // promoted in the same transaction.
  waitlisted Boolean  @default(false)
  createdAt  DateTime @default(now())

  org  Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slot SignupSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Block dupes by signed-in user; (slot, email, scout) handles the
  // anon path (scoutName "" for a guest signing up themselves).
  @@unique([slotId, userId])
  @@unique([slotId, email, scoutName])
  @@index([orgId, slotId])
}

model Rsvp {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String
  userId    String? // signed-in user (preferred path)
  memberId  String? // optional link to the directory entry
  name      String
  email     String?
  response  String   @default("yes") // yes | no | maybe
  guests    Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // Idempotent on (eventId, userId) when the user signed in, and on
  // (eventId, lower(email)) for anonymous email-link RSVPs.
  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([orgId, eventId])
  @@index([memberId])
  @@index([userId])
}

model Album {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  slug        String
  description String?
  visibility  String    @default("public") // public | members
  takenAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@unique([orgId, slug])
  @@index([orgId, takenAt])
}

model Photo {
  id              String    @id @default(cuid())
  orgId           String
  // Albums are the public-gallery surface. Chat-attached photos live
  // outside any album (albumId=null) and are reached via the chat
  // surface only — the /uploads route's auth check looks up the
  // attached message and confirms the viewer can read its channel.
  albumId         String?
  // Set when this photo is attached to a chat Message. Mutually
  // exclusive with albumId — a photo is either gallery-context or
  // chat-context. The /uploads route uses the populated side to
  // authorize. Setting deletedAt on the Message soft-deletes the
  // photo from chat without losing the file (audit retention).
  messageId       String?
  filename        String
  originalName    String?
  mimeType        String
  sizeBytes       Int
  caption         String?
  takenAt         DateTime?
  width           Int?
  height          Int?
  sortOrder       Int       @default(0)
  uploaderUserId  String?
  // Bytes-on-disk are encrypted with the org's DEK (AES-256-GCM)
  // when `encrypted = true`. encOriginalName replaces the plaintext
  // originalName field for new uploads (originalName is kept for
  // any pre-encryption photos until purged).
  encrypted       Boolean   @default(false)
  encOriginalName Bytes?
  createdAt       DateTime  @default(now())

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  album    Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader User?    @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([orgId, albumId, sortOrder])
  @@index([orgId, messageId])
  // /uploads/<key> looks photos up by filename on every image request.
  @@index([filename])
  @@index([albumId, sortOrder])
}

model Form {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  // A form is either an uploaded file (filename) or an external link
  // (url). At least one is required; the admin UI enforces it.
  url          String?
  filename     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  category     String? // health, permission, bylaws, welcome, ...
  visibility   String   @default("members") // public | members | leaders
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, category])
}

model MailLog {
  id             String   @id @default(cuid())
  orgId          String
  authorId       String?
  subject        String
  body           String
  channel        String   @default("email") // email | sms | both
  audienceLabel  String // "Everyone", "Adults", "Youth", "Patrol: Eagles", ...
  recipientCount Int      @default(0)
  // Per-recipient delivery state, updated as workers complete the
  // email.broadcast.send-one + sms.broadcast.send-one jobs. status
  // moves from "queued" → "sent"/"partial"/"failed" once
  // (deliveredCount + failedCount) === recipientCount.
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  // sent | partial | failed | dryrun | queued — queued is the new
  // default; previously every send was synchronous and rows landed
  // in "sent" immediately.
  status         String   @default("queued")
  errors         String?
  sentAt         DateTime @default(now())

  // Recipient snapshot — JSON array of { name, email, phone, channel } so the
  // history shows who got the message even if directory entries change later.
  recipients Json

  events MailEvent[]

  @@index([orgId, sentAt])
}

// Per-recipient tracking events for a MailLog row: image-pixel "open"s
// (email only) and link "click"s (email + SMS). Each row is one event;
// roll up at query time. We never store raw IP — only a SHA-256 hash —
// so the table can satisfy a "show me a parent's data" request without
// surfacing PII beyond what they typed in.
model MailEvent {
  id        String   @id @default(cuid())
  orgId     String
  mailLogId String
  recipient String // email or E.164 phone, matched against MailLog.recipients[]
  kind      String // "open" | "click"
  url       String? // destination URL for clicks
  userAgent String?
  ipHash    String? // SHA-256 of the request IP, never the raw IP
  createdAt DateTime @default(now())

  mailLog MailLog @relation(fields: [mailLogId], references: [id], onDelete: Cascade)

  @@index([mailLogId, kind])
  @@index([orgId, createdAt])
}

// Newsletter — a recurring digest the unit emails its families. Distinct
// from a one-off broadcast (MailLog) because newsletters are composed
// editorially: the leader writes a short intro, then auto-includes
// recent posts + upcoming events. Each Newsletter row is one issue, with
// a snapshot of which posts/events made it in. The actual send still
// goes through sendBatch() and records a MailLog row, so existing
// audit / history surfaces work unchanged.
model Newsletter {
  id               String    @id @default(cuid())
  orgId            String
  authorId         String?
  title            String // "Weekly Digest, May 4"
  // Markdown — leader's framing paragraph at the top of the issue.
  intro            String
  // Snapshot of which Posts + Events were included when the issue was
  // composed. Stored as ID arrays; the renderer pulls the live rows at
  // render time so URLs stay current.
  includedPostIds  String[]  @default([])
  includedEventIds String[]  @default([])
  // Same audience values as the broadcast composer — "everyone" / "adults"
  // / "youth" / "patrol" (with audiencePatrol set) / "subgroup:<id>".
  audience         String    @default("everyone")
  audiencePatrol   String?
  status           String    @default("draft") // draft | sent
  publishedAt      DateTime?
  // The MailLog row created when this issue was sent. Null for drafts.
  // Lets the admin Newsletter detail link straight to the recipient list
  // and bounce/complaint state.
  mailLogId        String?   @unique
  // Public archive visibility. "members" gates /newsletters behind login,
  // "public" lets the page show on the unit's public site like Posts.
  visibility       String    @default("members") // members | public
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org    Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId, publishedAt])
  @@index([orgId, status])
}

// CMS: per-org editable home-page content. Single record per org for now;
// later we can add slug + relax @unique to support multiple custom pages.
model Page {
  id           String   @id @default(cuid())
  orgId        String   @unique
  // Hero text — rendered into site.html at the top of every unit page.
  // Edited via Settings → Hero in the right rail of /admin/site. The
  // hero is fixed chrome; everything else lives on the canvas.
  heroHeadline String?
  heroLede     String?
  // The published canvas — JSON array of { id, type, ...config }
  // objects, in render order. Public site reads from here. Edited
  // via the GrapesJS surface at /admin/site, but writes land on
  // draftBlocks first; only Publish copies draft → customBlocks.
  customBlocks Json?
  // Unpublished work-in-progress. When non-null, the editor loads
  // from here instead of customBlocks. Save writes to draftBlocks;
  // Publish promotes to customBlocks (snapshotting the previous
  // customBlocks into PageVersion); Revert clears draftBlocks.
  draftBlocks  Json?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions PageVersion[]
}

model Announcement {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  body        String
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  pinned      Boolean   @default(false)
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org    Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId, publishedAt])
  @@index([orgId, pinned, publishedAt])
}

// Activity feed: a generic timeline post that can carry text, attached
// photos, or a referenced album. Subsumes "announcements + albums" into
// a single chronological surface; existing Announcement/Album models are
// kept around so older tenant content keeps rendering.
model Post {
  id          String   @id @default(cuid())
  orgId       String
  authorId    String?
  title       String?
  body        String
  visibility  String   @default("public") // public | members
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  photos    PostPhoto[]
  comments  Comment[]
  reactions PostReaction[]

  @@index([orgId, publishedAt])
  @@index([orgId, pinned, publishedAt])
}

// Member reactions on activity-feed posts. One row per (post, user,
// kind) — composite primary key dedupes natively, the API toggle
// pattern just upserts/deletes.
//
// `kind` is intentionally a small whitelist: "like" (👏) and
// "bookmark" (🔖). Bookmarks are personal — they don't surface to
// other users; likes do.
model PostReaction {
  postId    String
  userId    String
  kind      String // "like" | "bookmark"
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, kind])
  @@index([postId, kind])
  @@index([userId, kind])
}

model PostPhoto {
  id           String   @id @default(cuid())
  orgId        String
  postId       String
  filename     String
  originalName String?
  mimeType     String
  sizeBytes    Int
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId, postId, sortOrder])
}

// Trip & meal planner. One plan per Event. Headcount can be overridden,
// otherwise derived from the count of yes-RSVPs at render time.
model TripPlan {
  id                String   @id @default(cuid())
  orgId             String
  eventId           String   @unique
  headcountOverride Int?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org   Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meals Meal[]
  gear  GearItem[]

  @@index([orgId])
}

model Meal {
  id          String    @id @default(cuid())
  orgId       String
  tripPlanId  String
  name        String // "Saturday breakfast"
  recipeName  String? // "Foil packets", "Mac and cheese"
  notes       String?
  // "Contains" tags applied at the recipe level (e.g. "contains-meat",
  // "contains-gluten"). Cross-checked against each Member.dietaryFlags
  // to surface conflicts on the planner. See lib/dietary.js for the
  // canonical tag set and conflict map.
  dietaryTags String[]  @default([])
  sortOrder   Int       @default(0)
  servesAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tripPlan    TripPlan     @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]

  @@index([orgId, tripPlanId, sortOrder])
}

model Ingredient {
  id                String   @id @default(cuid())
  orgId             String
  mealId            String
  name              String // "Ground beef"
  quantityPerPerson Float // e.g., 0.25
  unit              String // "lb", "oz", "ea", "cup", ...
  category          String? // "Meat", "Produce", "Dairy", "Pantry", "Drinks", "Other"
  // Optional cost per `unit` (e.g. $5 per lb). When set, the trip plan
  // sums quantityPerPerson * unitCost across meals to surface a
  // cost-per-Scout estimate.
  unitCost          Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([orgId, mealId])
}

// Gear / equipment checklist for a trip. Items can be assigned to a
// Member (the Quartermaster, a parent volunteer) or left unassigned.
model GearItem {
  id          String   @id @default(cuid())
  orgId       String
  tripPlanId  String
  // Optional link to the permanent Quartermaster catalog. When set, the
  // gear item references a real Equipment row — clicking through opens
  // the catalog entry and surfaces the current loan / location.
  equipmentId String?
  name        String // "Patrol box", "Propane stove"
  quantity    Int      @default(1)
  assignedTo  String? // free-form name; future: link to Member
  notes       String?
  packed      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tripPlan  TripPlan   @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([orgId, tripPlanId, sortOrder])
  @@index([orgId, equipmentId])
}

// Comments on Posts. Members-only by definition (visibility lives on the
// parent Post; non-members can't even see the post). Authored by a User.
model Comment {
  id        String   @id @default(cuid())
  orgId     String
  postId    String
  authorId  String?
  body      String
  hidden    Boolean  @default(false) // soft-moderation by admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId, postId, createdAt])
}

// Permanent troop equipment catalog. Distinct from GearItem (which is
// a per-trip packing list). Tracks what the troop owns: patrol boxes,
// stoves, lanterns, propane tanks, the trailer itself, etc.
model Equipment {
  id          String    @id @default(cuid())
  orgId       String
  name        String // "Patrol box #1", "Coleman 2-burner stove"
  category    String? // "Patrol box", "Cooking", "Shelter", "Tools", ...
  serialOrTag String? // serial number or asset tag
  location    String? // "Trailer", "Storage closet", "Loaned: Smith family"
  condition   String    @default("good") // good | fair | needs-repair | retired
  quantity    Int       @default(1)
  acquiredAt  DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org       Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gearItems GearItem[]
  loans     EquipmentLoan[]

  @@index([orgId, category])
  @@index([orgId, location])
}

// Custom page — extra content pages beyond the home page (e.g. History,
// Bylaws summary, Eagle list, FAQ). Distinct from the Page model
// which holds editable home-page slots.
model CustomPage {
  id          String   @id @default(cuid())
  orgId       String
  slug        String // URL slug, lowercased, kebab-case
  title       String
  // Legacy markdown body. Used when `blocks` is null/empty so existing
  // pages keep rendering during the cutover. New pages saved via the
  // GrapesJS canvas write `blocks` and leave `body` alone.
  body        String // markdown-ish; rendered with paragraph + line-break preservation
  // Published canvas — same shape as Page.customBlocks. Render path
  // at /p/:slug prefers blocks if non-empty, falls back to `body`
  // Markdown otherwise.
  blocks      Json?
  // Unpublished work-in-progress (same draft/publish flow as Page).
  // When non-null, the editor loads from draftBlocks instead of blocks.
  draftBlocks Json?
  visibility  String   @default("public") // public | members
  sortOrder   Int      @default(0)
  showInNav   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions PageVersion[]

  @@unique([orgId, slug])
  @@index([orgId, sortOrder])
}

// Snapshot history for the homepage + custom pages. Each row is a
// frozen blocks array captured at Publish time, so an admin can
// restore "yesterday's version" as a fresh draft.
//
// Polymorphic: exactly one of pageId / customPageId is set. The
// editor's History panel queries by whichever surface it's on.
model PageVersion {
  id            String   @id @default(cuid())
  orgId         String
  pageId        String?
  customPageId  String?
  // The blocks array as it stood the moment Publish was clicked.
  blocks        Json
  publishedAt   DateTime @default(now())
  // Who pressed Publish. Nullable so deleting a User doesn't cascade
  // away the snapshot (history is auditable).
  publishedById String?
  // Optional human label admins can attach later ("Pre-spring-camporee").
  // Not exposed in v1 UI, but reserved so we don't have to migrate
  // when the rename feature lands.
  label         String?

  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  page        Page?       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customPage  CustomPage? @relation(fields: [customPageId], references: [id], onDelete: Cascade)
  publishedBy User?       @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([orgId, publishedAt])
  @@index([pageId, publishedAt])
  @@index([customPageId, publishedAt])
}

// Per-org calendar category vocabulary. Replaces the hardcoded list
// in lib/eventCategories.js as the source of truth — admins manage
// labels + colors at /admin/categories. Event.category stores the
// slug (free-form string, no FK) so deleting a category doesn't
// orphan/break events; the slug just falls back to a generic label.
//
// Defaults are seeded lazily on first /admin/categories visit (see
// ensureDefaultEventCategories) so existing orgs migrate transparently.
model EventCategory {
  id        String   @id @default(cuid())
  orgId     String
  slug      String // stable lowercase id matched against Event.category
  label     String // human label shown in pickers + tags
  color     String // hex (#rrggbb) for the tag background
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId, sortOrder])
}

// Surveys: leader-composed question sets that members (or anyone, if
// the survey is set to allow it) can fill out. Questions stored as
// JSON so we can support text / select / scale / yes-no without a
// table per question type. Responses likewise — answers keyed by
// question id.
model Survey {
  id          String    @id @default(cuid())
  orgId       String
  slug        String
  title       String
  description String?
  // Array of { id, type, label, options?, required } objects. Types:
  //   "text"   — short free-form
  //   "long"   — paragraph
  //   "yesno"  — boolean
  //   "select" — pick one of options[]
  //   "multi"  — pick any of options[]
  //   "scale"  — 1–5
  questions   Json      @default("[]")
  // who can respond:
  //   "anyone"  — anonymous form, name + email required
  //   "members" — sign-in required
  audience    String    @default("anyone")
  closesAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org       Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@unique([orgId, slug])
  @@index([orgId, createdAt])
}

model SurveyResponse {
  id        String   @id @default(cuid())
  orgId     String
  surveyId  String
  userId    String? // signed-in path
  name      String
  email     String?
  // Map of questionId → answer (string | boolean | number | string[])
  answers   Json
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([orgId, surveyId])
}

// Eagle Scout — public list of the troop's Eagles. Distinct from
// EagleProject (the workflow). Just names + dates for the public page.
model EagleScout {
  id          String   @id @default(cuid())
  orgId       String
  firstName   String
  lastName    String
  // ECOH date — when they earned Eagle.
  earnedAt    DateTime
  projectName String?
  // Optional link to a Member record (if still on the roster).
  memberId    String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, earnedAt])
}

// Eagle project workflow — internal tracker for in-progress and
// completed Eagle projects. Lives in Scouthosting (we're the
// communication / planning layer); the workbook itself lives in
// Scoutbook (advancement system of record).
model EagleProject {
  id          String    @id @default(cuid())
  orgId       String
  scoutName   String // typed; we don't enforce a Member link
  beneficiary String? // who the project serves
  mentorName  String?
  status      String    @default("idea") // idea | proposal | approved | in-progress | complete
  workbookUrl String? // link to the BSA workbook (uploaded elsewhere)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

// Court of Honor program — list of awards / recognitions for a CoH
// event. Each row prints as a line item on the printable program.
// Tied to an Event (typically with category = "Court of Honor").
model CohAward {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String
  recipient String // "Demo Scout 2"
  award     String // "Tenderfoot rank", "First Aid merit badge", "Mile-Swim award"
  category  String? // "Rank", "Merit Badge", "Award", "Recognition"
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orgId, eventId, sortOrder])
}

// Position-of-Responsibility history. Each term is a (member, position,
// startedAt, endedAt) tuple — endedAt = null means "currently holding".
// Member.position keeps the current label denormalized for fast list
// rendering; on save the admin reconciles by closing the open term and
// opening a new one when the label changes.
model PositionTerm {
  id        String    @id @default(cuid())
  orgId     String
  memberId  String
  position  String // "SPL", "Scoutmaster", "Patrol Leader — Eagles"
  startedAt DateTime
  endedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId, startedAt])
  @@index([orgId, endedAt])
}

// Adult-leader training history. BSA YPT (Youth Protection Training)
// expires every 2 years; other courses (IOLS, Wood Badge, Scoutmaster
// Specifics) typically don't. expiresAt = null means "doesn't expire";
// otherwise the org-wide /admin/training page surfaces an "expires
// soon" warning when the date is within 60 days.
model Training {
  id          String    @id @default(cuid())
  orgId       String
  memberId    String
  courseName  String // "Youth Protection Training", "IOLS", "Wood Badge", ...
  completedAt DateTime
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId, completedAt])
  @@index([orgId, expiresAt])
}

// Audit log — who edited what, when. v1 captures CMS / member writes;
// the security backlog escalates this to "every read/write to youth
// records" with cryptographic chaining for tamper-evidence.
//
// userId may be null for system actions (provisioning, automated
// reconcile). userDisplay snapshots the actor's display name at the
// time of the action so log lines stay readable after a leader
// rotates out of the org.
// AuditLog is org-scoped historically, but the first-party telemetry
// beacon also writes anonymous marketing-funnel events (no org, no
// user) here so the rollup story stays unified. orgId is nullable;
// when null the row represents an apex/marketing event.
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String?
  userId      String?
  userDisplay String?
  entityType  String // "Page", "Announcement", "Post", "Member", ...
  entityId    String?
  action      String // "create", "update", "delete"
  summary     String? // short human-readable: "Edited About body"
  createdAt   DateTime @default(now())

  org Org? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, createdAt])
  @@index([action, createdAt])
}

// Error tracking — what `lib/errorTracker.js` writes when a request
// throws. Each row is a single occurrence; rollup by `fingerprint`
// (a hash of the error's name + first stack frame) so /__super/errors
// can show "this exception, seen 47 times across the last 24h".
//
// orgId / userId are nullable: process-level fatal handlers (uncaught
// exceptions, unhandled rejections) and apex requests don't have a
// resolved org. Foreign keys SetNull on delete so deleting an org
// doesn't cascade-clobber its error history.
//
// Persisted alongside the existing stdout JSON — the in-app viewer
// at /__super/errors gives operator-grade visibility without a
// third-party SaaS. External backends (GCP Cloud Error Reporting,
// Grafana Cloud, Honeycomb) still ingest the stdout stream.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String // sha1(name + first stack frame), 40 hex chars
  message     String
  stack       String?
  errorName   String? // "TypeError", "PrismaClientKnownRequestError", ...
  // Request context
  method      String?
  path        String?
  orgId       String?
  userId      String?
  requestId   String?
  ip          String?
  // Release tracking
  release     String?
  environment String?
  createdAt   DateTime @default(now())

  org  Org?  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fingerprint, createdAt])
  @@index([createdAt])
  @@index([orgId, createdAt])
}

// Driver / carpool plan. Distinct from SignupSlot's generic
// "Drivers / carpool" template — that captures *who can drive*. CarRide
// captures *the actual ride*: vehicle, seats, departure plan, and the
// list of riders assigned to it. v1 is admin-managed (leaders build
// the plan manually based on RSVPs).
model CarRide {
  id                String    @id @default(cuid())
  orgId             String
  eventId           String
  driverName        String
  driverEmail       String?
  driverPhone       String?
  vehicleNote       String? // "Honda Pilot — silver", "15-passenger van"
  seats             Int       @default(4)
  departureTime     DateTime?
  departureLocation String?
  returnTime        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org    Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event  Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  riders CarRideRider[]

  @@index([orgId, eventId])
}

model CarRideRider {
  id        String   @id @default(cuid())
  orgId     String
  rideId    String
  memberId  String?
  name      String
  email     String?
  isYouth   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  org  Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ride CarRide @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([orgId, rideId])
}

// Troop's preferred Merit Badge Counselor list. Local-only, troop-curated;
// distinct from Scoutbook's national MBC directory. v1 captures who the
// troop actually uses for which badges. Scouts and parents read this list
// when they're picking a counselor.
model MeritBadgeCounselor {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String?
  phone     String?
  badges    String[] @default([]) // e.g. ["First Aid", "Camping", "Citizenship in the Community"]
  // Optional link to a roster member if the counselor is also part of
  // the unit. Free-form names are allowed too — many councils share
  // counselors across units.
  memberId  String?
  notes     String? // "Best for First Aid; reach out via email", "Lives in Oakdale"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member     Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  eventStaff EventStaff[]

  @@index([orgId, name])
  @@index([orgId, memberId])
}

// An adult helping run an event: a merit badge counselor at a badge
// day, a station staffer, a general volunteer, or the event lead.
// Unlike Rsvp (families attending), these are the people the event
// needs. A staffer may not have a Compass account: they answer from
// the emailed link (rsvpTokenHash holds a SHA-256 of that link's
// token, never the token) or, once signed in, from the app, which
// links userId on the first match by email. Adults only: adding an
// address that belongs to a youth Member is refused.
model EventStaff {
  id            String    @id @default(cuid())
  orgId         String
  eventId       String
  userId        String?
  counselorId   String? // optional link to the org's counselor directory
  name          String
  email         String // stored lowercased
  phone         String?
  role          String    @default("volunteer") // counselor | staff | volunteer | lead
  slotId        String? // the station (SignupSlot) they work, if any
  status        String    @default("invited") // invited | yes | no | maybe
  rsvpTokenHash String?   @unique
  notes         String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org       Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  counselor MeritBadgeCounselor? @relation(fields: [counselorId], references: [id], onDelete: SetNull)
  slot      SignupSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([orgId, eventId])
  @@index([userId])
  @@index([email])
  @@index([slotId])
}

// ------------------------------------------------------------------
// Merit badge counseling (Waypoint app, /api/v1 counselor routes)
// ------------------------------------------------------------------
//
// MeritBadgeCounselor above is a leader-maintained, per-org directory
// of names (often people with no Compass account). The models below
// are the signed-in side: a User who counsels badges, which scouts a
// unit has assigned to them, requirement progress and sign-offs, and
// counselor meetings. Badge slugs and requirement ids follow the
// scout-core catalog (src/lib/counselor/ids.ts).

// Badges a signed-in adult counsels. Per user, not per org: counselors
// register with the council and serve every unit, so one list follows
// them across orgs. Units still decide who counsels their scouts
// through CounselorAssignment.
model CounselorBadge {
  userId    String
  badgeSlug String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeSlug])
  @@index([badgeSlug])
}

// A unit admin/leader assigns a counselor (an adult org member) to a
// scout for one badge. This is what lets the counselor see the scout
// on their roster and sign off that badge's requirements.
model CounselorAssignment {
  id              String   @id @default(cuid())
  orgId           String
  counselorUserId String
  memberId        String // the scout (Member.isYouth)
  badgeSlug       String
  createdById     String?
  createdAt       DateTime @default(now())

  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  counselor User   @relation("AssignedCounselor", fields: [counselorUserId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([counselorUserId, memberId, badgeSlug])
  @@index([orgId, memberId])
  @@index([orgId, counselorUserId])
}

// Current state of one requirement for one scout. requirementId is a
// scout-core id like "badge:plumbing#6b". status is one of
// not_started | in_progress | done | signed_off; signedOffById/At are
// set by the server when status becomes signed_off and cleared when it
// leaves it. Every change also appends a RequirementProgressEvent.
model RequirementProgress {
  id            String    @id @default(cuid())
  orgId         String
  memberId      String
  requirementId String
  status        String
  note          String?
  signedOffById String?
  signedOffAt   DateTime?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, requirementId])
  @@index([orgId])
}

// Append-only history of requirement changes: who moved which
// requirement from what to what, and when. Never updated or deleted by
// the app (rows go only when the scout or org is removed).
model RequirementProgressEvent {
  id            String   @id @default(cuid())
  orgId         String
  memberId      String
  requirementId String
  fromStatus    String?
  toStatus      String
  note          String?
  actorUserId   String?
  createdAt     DateTime @default(now())

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, requirementId, createdAt])
  @@index([orgId, createdAt])
}

// A counselor meeting with one or more scouts. Youth protection: the
// meeting stores who must be notified (CounselorMeetingNotify): every
// linked parent of every scout, plus any other adults the counselor
// named. Each scout needs a parent contact or another adult on the
// meeting, or creating it is refused. Compass
// doesn't send meeting notifications yet; whatever sends them must use
// this list so parents are always copied, and never email a scout
// directly.
model CounselorMeeting {
  id              String    @id @default(cuid())
  orgId           String
  counselorUserId String
  badgeSlug       String
  startsAt        DateTime
  endsAt          DateTime?
  place           String
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org       Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  counselor User                     @relation(fields: [counselorUserId], references: [id], onDelete: Cascade)
  scouts    CounselorMeetingScout[]
  notify    CounselorMeetingNotify[]

  @@index([counselorUserId, startsAt])
  @@index([orgId, startsAt])
}

model CounselorMeetingScout {
  meetingId String
  memberId  String

  meeting CounselorMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([meetingId, memberId])
  @@index([memberId])
}

// Who a meeting notification goes to. kind "parent": a scout's linked
// parent Member (forMemberId is the scout). kind "adult": another
// adult org member, by userId. References only; contact details are
// read from Member/User at send time so they stay current and PII
// isn't copied.
model CounselorMeetingNotify {
  id          String  @id @default(cuid())
  meetingId   String
  kind        String
  memberId    String?
  forMemberId String?
  userId      String?

  meeting CounselorMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

// Reimbursement request — a member submits an expense, the treasurer
// reviews and marks it paid. The receipt file goes into the same per-org
// storage area as photos and forms. amountCents avoids float drift.
//
// Status transitions:
//   pending → approved → paid     (happy path)
//   pending → denied              (rejected)
//   pending → paid                (treasurer skips approval — small unit shorthand)
model Reimbursement {
  id               String    @id @default(cuid())
  orgId            String
  requesterUserId  String?
  requesterName    String
  requesterEmail   String?
  eventId          String?
  amountCents      Int
  purpose          String
  receiptFilename  String?
  receiptMimeType  String?
  status           String    @default("pending") // pending | approved | denied | paid
  submittedAt      DateTime  @default(now())
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedByDisplay String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([orgId, status, submittedAt])
  @@index([orgId, requesterUserId])
}

// Order of the Arrow election. Each troop typically holds one a year.
// We track the slate, the result, and lodge submission state — actual
// voting happens in person at a meeting.
//
// Status transitions:
//   planned → conducted → submitted
model OaElection {
  id                 String   @id @default(cuid())
  orgId              String
  electionDate       DateTime
  lodgeName          String?
  lodgeNumber        String?
  oaTeamContact      String?
  oaTeamContactEmail String?
  votingMembersCount Int? // size of the active voting unit at the time
  votingThreshold    Int? // 50% + 1 of voting members
  status             String   @default("planned") // planned | conducted | submitted
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org        Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidates OaCandidate[]

  @@index([orgId, electionDate])
}

model OaCandidate {
  id            String   @id @default(cuid())
  orgId         String
  electionId    String
  memberId      String?
  candidateName String
  status        String   @default("eligible") // eligible | elected | not-elected | declined
  votesFor      Int?
  votesAgainst  Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org      Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  election OaElection @relation(fields: [electionId], references: [id], onDelete: Cascade)
  member   Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([orgId, electionId])
}

// Video gallery — link-based, not hosted. URL points at YouTube or
// Vimeo; the renderer derives the embed URL from the link. Hosting
// video ourselves is a heavier feature tracked separately in the
// roadmap.
model Video {
  id           String    @id @default(cuid())
  orgId        String
  title        String
  url          String
  thumbnailUrl String?
  recordedAt   DateTime?
  notes        String?
  visibility   String    @default("members") // public | members
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sortOrder])
}

// API tokens for the mobile app + future external clients. Issued by an
// authenticated user via /api/v1/auth/token; the raw token is shown to
// the caller exactly once and only the SHA-256 hash is stored. Verifying
// is constant-time-equal of the hash on the incoming bearer.
//
// One user can have many active tokens (one per device). Revoking a token
// stamps revokedAt; no client-side cleanup required.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  // Tokens stop working after this. Null only on rows minted before
  // expiry existed; the migration that added it backfilled those.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Group-chat channel. Always belongs to an org. The kind drives both the
// auto-creation rules and the YPT two-deep enforcement:
//
//   patrol    — youth + ≥2 YPT-current adults; one per Member.patrol
//   troop     — every member of the org
//   parents   — parents + leaders (no youth)
//   leaders   — registered leaders only (no youth, no parents)
//   event     — auto-archives 24h after the event ends
//   custom    — leader-created ad-hoc thread
//   broadcast — Subgroup-replacement: members are computed from
//               autoAddRules and the channel acts as a targeted
//               distribution list rather than a chat thread (PR-C0
//               foundation; cutover from Subgroup happens in PR-C1).
//
// `isSuspended` flips to true the moment the YPT guard sees fewer than
// two current adults in a youth-containing channel. Suspended channels
// are read-only until the threshold is restored.
model Channel {
  id              String    @id @default(cuid())
  orgId           String
  kind            String // patrol | troop | parents | leaders | event | custom | broadcast
  name            String
  // Optional human-readable description, shown in admin and on member-
  // facing channel pages. Replaces Subgroup.description for broadcast
  // channels and is generally useful elsewhere too.
  purpose         String?
  patrolName      String? // for kind=patrol; matches Member.patrol
  // kind=event: the event this channel belongs to. An event can have
  // several channels, one per audience (and one per station).
  eventId         String?
  // kind=event only. Who the reconciler puts in the channel:
  //   staff    — event staff who said yes/maybe, plus org leaders
  //   station  — the staff assigned to `slotId`, plus org leaders
  //   families — RSVP'd and signed-up families, plus org leaders
  // null on event channels made before audiences existed = families.
  audience        String?
  slotId          String? // kind=event, audience=station: the station's SignupSlot
  // Rule-based membership for kind=broadcast (and any future kind that
  // wants dynamic membership). Shape:
  //   { patrols?: string[], skills?: string[],
  //     interests?: string[], trainings?: string[] }
  // The reconciler intersects all non-empty arrays — a channel with
  // patrols=["Wolves"] AND skills=["first-aid"] only auto-adds Wolves
  // who hold first-aid, not the union. null means "no rules; manual
  // membership only", which matches every existing Channel.
  autoAddRules    Json?
  // Who's allowed to post a message to this channel:
  //   "everyone" — any org member can post (broadcast-style)
  //   "members"  — only ChannelMember rows can post (default)
  //   "section"  — only members whose Member.patrol matches patrolName
  //                can post (e.g. only Wolf Den parents post in Wolf Den)
  //   "leaders"  — only adult leaders + admins can post (announcement-only)
  // Adult leaders + admins always pass; this gate scopes who *else* can post.
  postPolicy      String    @default("members")
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org      Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event    Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  slot     SignupSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  members  ChannelMember[]
  messages Message[]

  @@index([orgId, kind])
  @@index([eventId])
  @@index([orgId, archivedAt])
}

// User-to-channel join row. Auto-managed by the channel reconciler for
// patrol / troop / parents / leaders / event channels — addedAutomatically
// is true for those. Manual owner promotions / demotions carry false so
// the reconciler doesn't undo a leader's deliberate override.
model ChannelMember {
  id                 String    @id @default(cuid())
  channelId          String
  userId             String
  // Slack-style channel role. "owner" lets the user post into a channel
  // set to the announce-only "leaders" policy and (eventually) manage
  // the channel's settings. Pre-20260503010000 the value was "moderator";
  // the migration in that timestamp folder rewrites every existing row.
  role               String    @default("member") // member | owner
  joinedAt           DateTime  @default(now())
  mutedUntil         DateTime?
  addedAutomatically Boolean   @default(true)
  // High-water mark for read state: every Message in this channel with
  // createdAt <= lastReadAt is considered "seen by this member". Bumped
  // to NOW() on channel-detail GET (any time the user opens the
  // channel) and via POST /api/v1/channels/:id/read. Drives both the
  // "seen by …" receipt UI and the cron sweep that emails reminders
  // for unread DMs after 30 minutes.
  lastReadAt         DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

// Chat message. Soft-delete via deletedAt so the 7-year audit retention
// for youth-containing threads stays intact. attachmentJson is a small
// embedded structure for poll cards / RSVP cards / photo refs — keeping
// it as Json lets us evolve the embed shape without a migration each
// time.
model Message {
  id                  String    @id @default(cuid())
  channelId           String
  authorId            String?
  body                String
  attachmentJson      Json?
  pinned              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  editedAt            DateTime?
  deletedAt           DateTime?
  // Set by the email-reminder cron when it sends the "you have a
  // message" nudge for an unread DM. Idempotent — never re-fires for
  // the same Message even if the recipient stays unread for days.
  emailReminderSentAt DateTime?

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions Reaction[]
  photos    Photo[]

  @@index([channelId, createdAt])
  // Cron sweep wants to find DM messages older than 30 min that haven't
  // been emailed yet — narrow index supports that scan without a full
  // table scan.
  @@index([emailReminderSentAt, createdAt])
  @@index([authorId])
}

// Emoji reaction. Composite primary key (messageId, userId, emoji) so a
// user can react with the same emoji at most once per message.
model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

// Inbound support requests. A leader hits "Contact support" on the
// admin shell or a member hits the /help link on the public site;
// either way the message lands here for the super-admin to triage.
//
// status flow: open → acknowledged → resolved | closed
//   - open       — needs triage
//   - acked      — super-admin replied or assigned but not resolved
//   - resolved   — fixed; auto-archive after 30d
//   - closed     — won't-fix or duplicate
//
// We don't link to User by FK because logged-out members + apex
// Provisioning template — a named set of seed data a super-admin can
// edit and the "new org" form can clone from. Replaces the hardcoded
// SUBGROUP_VOCAB / SUBGROUP_PRESETS in lib/orgRoles.js.
//
// Built-in templates ship with the seed (Cub Scout Pack, Girl Scout
// Troop). They're editable but can't be deleted — the UI forces a
// clone-to-customize path. Custom templates are leader-creatable
// via /__super/templates.
//
// JSON shapes:
//   vocab:           { singular, plural, heading }
//   subgroupPresets: [{ key, label, grade }]
//   positionList:    [position-name strings] (optional, future use)
//   customPagesSeed: [{ slug, title, body, visibility }] (optional)
// JSON shapes:
//   vocab:                { singular, plural, heading }
//   subgroupPresets:      [{ key, label, grade }]
//   positionList:         [position-name strings] (optional, future use)
//   customPagesSeed:      [{ slug, title, body, visibility }] (optional)
//   eventCategoriesSeed:  [{ slug, label, color }] (optional) — copied
//                         into EventCategory at provision time so a
//                         freshly-created org lands with a usable
//                         category vocabulary instead of falling back
//                         to the lib/eventCategories.js hardcoded 12.
model OrgTemplate {
  id                  String   @id @default(cuid())
  name                String   @unique // "Cub Scout Pack" / "Girl Scout Troop" / leader-named custom
  unitType            UnitType
  vocab               Json
  subgroupPresets     Json     @default("[]")
  positionList        Json?
  customPagesSeed     Json?
  eventCategoriesSeed Json?
  isBuiltIn           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([unitType])
}

// signup-page visitors can also file tickets. We snapshot whatever
// identity we have at write time.
model SupportTicket {
  id                 String    @id @default(cuid())
  orgId              String?
  userId             String?
  fromEmail          String
  fromName           String?
  category           String    @default("question") // question | bug | billing | abuse | feature | other
  subject            String
  body               String
  status             String    @default("open")
  priority           String    @default("normal") // low | normal | high | urgent
  assignedTo         String?
  resolutionNote     String?
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Bug-report attachment captured by the in-page support widget when
  // the user picks the "bug" category. The widget runs html2canvas
  // against the current viewport, uploads the PNG to /uploads via the
  // standard storage driver, and records the filename + the page that
  // was screenshotted here. operator views the image inline on
  // /__super/support/:id alongside the body.
  screenshotFilename String?
  screenshotMimeType String?
  viewportPath       String? // pathname the user was on when they hit "report bug"
  viewportWidth      Int?
  viewportHeight     Int?

  org Org? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orgId])
}

// Operator-issued refund / billing credit. Compass doesn't process
// payments — units collect dues out-of-band (check, Venmo, Scoutbook,
// etc.) — but we *do* charge the unit a SaaS fee. This row records
// when the super-admin gives a unit a credit or refund against that
// fee. paymentRef is a free-form pointer to whatever billing system
// processed it (today: a manual note; future: an invoice id).
model Refund {
  id          String   @id @default(cuid())
  orgId       String
  paymentRef  String? // free-form ref to the source payment
  amountCents Int
  reason      String
  issuedBy    String // User.id of the super-admin who issued it
  status      String   @default("issued") // issued | failed
  notes       String?
  createdAt   DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// Mobile push-notification device registration.
//
// One row per (user, device-installation). The mobile app calls
// POST /api/v1/push/register on launch with its Expo push token (or
// raw APNs / FCM token); we store + dedupe on (userId, token). When
// a leader sends a broadcast, lib/push iterates pushDevices for the
// audience and dispatches.
//
// Unregister happens automatically on logout (mobile clears the
// stored token + posts /push/unregister) and on receiving a "bad
// device" response from the push provider (token gets soft-deleted).
model PushDevice {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  // "expo" | "apns" | "fcm". Drives which sender lib/push uses.
  provider      String    @default("expo")
  // Per-device label so a user can see "iPhone 15 Pro" / "Pixel 8" in
  // their profile and revoke selectively. Optional.
  deviceLabel   String?
  // App platform — "ios" | "android" | "web". Useful for partial
  // outages (Apple downtime → skip ios devices).
  platform      String?
  // Soft-delete timestamp set when the push provider returns "bad
  // device" (recipient uninstalled / disabled notifications). Skipped
  // by the broadcaster but kept for audit.
  retiredAt     DateTime?
  retiredReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([retiredAt])
}

// ------------------------------------------------------------------
// Public roadmap / feedback board
// ------------------------------------------------------------------
//
// Design source: design_handoff_compass/designs/feedback.jsx
//
// Distinct from SupportTicket above: SupportTicket is a private 1:1
// help ticket. FeedbackRequest is a public roadmap entry — anyone in
// the troop (or, when scope=global, any Compass tenant) can vote, and
// status moves through Submitted → Triaged → Building → Shipped with
// engineering update notes the team writes back as the work happens.

enum FeedbackStatus {
  submitted
  triaged
  building
  shipped
  declined
}

enum FeedbackKind {
  feature
  bug
  help // private, gets routed to SupportTicket flow instead
}

enum FeedbackScope {
  org // visible only to this troop
  global // visible across the public Compass roadmap
}

model FeedbackRequest {
  id          String  @id @default(cuid())
  // Who wrote it. orgId may be null for anonymous global submissions
  // (we still record the email on SupportTicket-style flows).
  orgId       String?
  userId      String?
  authorEmail String?
  authorName  String?

  kind   FeedbackKind   @default(feature)
  scope  FeedbackScope  @default(org)
  status FeedbackStatus @default(submitted)

  title    String
  body     String  @db.Text
  category String? // free-form bucket: Calendar / Events / Safety / etc.

  // Auto-attached context from the composer: troop, role, browser,
  // last-visited page snapshot. Stored as JSON so we don't need a
  // schema migration every time we collect a new field.
  context Json?

  // Cached vote count — kept in sync by application code on every
  // FeedbackVote insert/delete. Indexed so "most votes" is cheap.
  voteCount Int @default(0)

  // Latest engineering update note the operator left. Surfaces inline
  // on the roadmap card. Older updates flow through FeedbackComment.
  lastUpdate    String?   @db.Text
  lastUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org?              @relation(fields: [orgId], references: [id], onDelete: SetNull)
  author   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes    FeedbackVote[]
  comments FeedbackComment[]

  @@index([scope, status, voteCount])
  @@index([orgId, createdAt])
  @@index([category])
}

// One vote per (request, user). The unique constraint enforces it at
// the DB level so the API doesn't have to.
model FeedbackVote {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

// Threaded comments on a feedback request. `isOperator=true` rows are
// engineering update notes — they render with the colored panel on
// the public board and the most recent one is mirrored to
// FeedbackRequest.lastUpdate.
model FeedbackComment {
  id         String   @id @default(cuid())
  requestId  String
  userId     String?
  authorName String? // for operator-replies posted from /__super
  body       String   @db.Text
  isOperator Boolean  @default(false)
  createdAt  DateTime @default(now())

  request FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// ------------------------------------------------------------------
// Newsletter scheduling & automated reminders
// ------------------------------------------------------------------
//
// Design source: design_handoff_compass/designs/newsletter.jsx
//
// The existing `Newsletter` model is one published or scheduled issue.
// `NewsletterSchedule` stores the per-org cadence (every Sunday at 7
// PM, etc.) used to auto-create draft issues. `NewsletterRule` stores
// the per-org "set it once, runs forever" reminders (RSVP nudges, dues
// reminders, post-campout recap, Eagle CoH invites, welcome onboarding).

model NewsletterSchedule {
  id            String    @id @default(cuid())
  orgId         String    @unique
  // ISO weekday (1=Mon … 7=Sun). Sunday default.
  weekday       Int       @default(7)
  // Local time of day, "HH:MM".
  localTime     String    @default("19:00")
  timezone      String    @default("America/Chicago")
  senderName    String?
  replyToEmail  String?
  // Skip the issue if Compass found fewer than `minStories` stories.
  minStories    Int       @default(2)
  // Pause the schedule entirely.
  paused        Boolean   @default(false)
  // Last successful auto-draft creation.
  lastDraftedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum NewsletterRuleKind {
  rsvp_nudge // 7d before any open RSVP
  dues_reminder // 14 / 7 / 1 days before due
  post_event_recap // 2 days after a campout, when 5+ photos uploaded
  eagle_coh_invite // on Scoutbook BoR pass
  new_family_drip // 3-email onboarding drip
  reengage_quiet // after 3 missed meetings
  birthday // birthday week shoutout
  packing_list // 5d before a campout
  medform_expiry // 30d before annual medical form expiry
  custom
}

model NewsletterRule {
  id          String             @id @default(cuid())
  orgId       String
  kind        NewsletterRuleKind
  title       String
  description String?            @db.Text
  // Free-form configuration: cron-ish schedule, audience filter, etc.
  config      Json?
  enabled     Boolean            @default(true)
  // Audit: when did this rule last fire? what did it do?
  lastFiredAt DateTime?
  lastResult  String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, enabled])
  @@index([kind])
}

// Pre-launch invite codes. Apex (https://scoutingcompass.com) is gated
// behind a "Coming Soon" page until the visitor types a valid code,
// at which point we set a signed cookie and let them browse marketing.
// Tenant subdomains are not gated by this — they belong to live orgs.
//
// Codes are seeded by hand for now (see prisma/seed.ts). `maxUses = 0`
// means unlimited; `usedCount` tracks how many times the code has
// successfully unlocked, mostly for analytics.
model InviteCode {
  id         String    @id @default(cuid())
  code       String    @unique
  label      String?
  maxUses    Int       @default(0)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Electronic permission slip — captured when a parent clicks the
// signed token in an email and types their name as a signature on
// /permission-slip/[token]. One row per (event, member); a re-sign
// overwrites via the @@unique constraint. We store the slipText
// snapshot so a leader editing the event's text after the fact
// doesn't retroactively change what the parent agreed to. signedIp
// is captured for audit; emails go through Resend webhooks already
// so this is a complementary record.
model PermissionSlip {
  id               String   @id @default(cuid())
  orgId            String
  eventId          String
  memberId         String
  // Typed signature — parent's name as they entered it. Free text;
  // we don't try to validate against the linked Member name because
  // it may not be encrypted-comparable from a public route.
  signedByName     String
  signedByEmail    String?
  signedAt         DateTime @default(now())
  signedIp         String?
  slipTextSnapshot String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([orgId, eventId])
  @@index([orgId, memberId])
}

// Equipment loan ledger. The Equipment model already exists for
// trip-only assignments; EquipmentLoan promotes it into a real
// member-borrowing log. Members borrow tents, dutch ovens, etc.;
// the loan is open until returnedAt is set. A piece of equipment
// can have multiple historical loans, only one of which is active
// at a time (returnedAt = null).
model EquipmentLoan {
  id          String    @id @default(cuid())
  orgId       String
  equipmentId String
  memberId    String
  loanedAt    DateTime  @default(now())
  // Soft due date for "should be returned by"; surfaced as overdue
  // when now() > dueAt and returnedAt is null.
  dueAt       DateTime?
  returnedAt  DateTime?
  // Free-form on the way out (condition, count, accessories) and on
  // the way back (damage, missing pieces).
  loanNotes   String?
  returnNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, equipmentId, returnedAt])
  @@index([orgId, memberId, returnedAt])
}

// =====================================================================
// Treasury — see docs/treasury-design.md.
// Single-entry ledger with reversal-only edits; per-Member subaccounts;
// per-fund rollups. Money columns are plaintext on purpose so the
// treasurer can SUM/sort across members without unwrapping a vault.
// =====================================================================

model Fund {
  id                         String   @id @default(cuid())
  orgId                      String
  // Stable code for system funds (`general`, `scout-accounts`,
  // `stripe-fees`); free-form for custom funds.
  code                       String
  name                       String
  isSystem                   Boolean  @default(false)
  archived                   Boolean  @default(false)
  // Cached running balance, recomputed in the same transaction as
  // every Transaction insert. Validated nightly.
  balanceCents               Int      @default(0)
  // Optional Stripe configuration: when a fund opts into receiving
  // online payments we record the destination account here. Null on
  // most funds; only `general` typically wires.
  stripeDestinationAccountId String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  org          Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      FundBudget[]
  campaigns    SalesCampaign[]

  @@unique([orgId, code])
  @@index([orgId, archived])
}

model MemberSubaccount {
  id           String   @id @default(cuid())
  orgId        String
  memberId     String   @unique
  // Cached running balance against the scout-accounts fund.
  // Positive = unit owes the family (credit); negative = family owes
  // the unit. Inverse of TWH's convention so leaders can read
  // balances like a bank statement.
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Transaction {
  id                    String   @id @default(cuid())
  orgId                 String
  fundId                String
  memberId              String?
  eventId               String?
  reimbursementId       String?
  // type drives the posting UI grouping. Values:
  //   dues | event-charge | deposit | expense |
  //   transfer-out | transfer-in | refund |
  //   fundraiser-credit | sale | manual
  type                  String
  // Signed cents. Positive = money in (or charge added to a member
  // subaccount); negative = money out / credit applied. Reversals
  // are inserted as opposite-sign rows that point at the original.
  amountCents           Int
  description           String
  postedAt              DateTime @default(now())
  // Reversal pointer — set on the *new* opposite-sign row that
  // cancels an earlier transaction. The original row is never
  // mutated; the read path collapses pairs.
  reversesId            String?  @unique
  // Stripe / bank reconciliation pointers.
  stripePaymentIntentId String?
  bankImportRowId       String?
  // Optional sales linkage for fundraising flows.
  salesOrderId          String?
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fund          Fund           @relation(fields: [fundId], references: [id], onDelete: Restrict)
  member        Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reimbursement Reimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  reverses      Transaction?   @relation("TransactionReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy    Transaction[]  @relation("TransactionReversal")
  bankImportRow BankImportRow? @relation(fields: [bankImportRowId], references: [id], onDelete: SetNull)
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  @@index([orgId, postedAt])
  @@index([orgId, fundId, postedAt])
  @@index([orgId, memberId, postedAt])
  @@index([orgId, eventId])
  @@index([stripePaymentIntentId])
}

model FiscalYear {
  id        String    @id @default(cuid())
  orgId     String
  label     String
  startsOn  DateTime
  endsOn    DateTime
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org     Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  budgets FundBudget[]

  @@unique([orgId, label])
  @@index([orgId, startsOn])
}

model FundBudget {
  id            String   @id @default(cuid())
  orgId         String
  fiscalYearId  String
  fundId        String
  expectedCents Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fund       Fund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, fundId])
  @@index([orgId, fiscalYearId])
}

model BankImport {
  id           String   @id @default(cuid())
  orgId        String
  filename     String
  format       String
  uploadedById String?
  uploadedAt   DateTime @default(now())

  org  Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rows BankImportRow[]

  @@index([orgId, uploadedAt])
}

model BankImportRow {
  id          String    @id @default(cuid())
  importId    String
  postedAt    DateTime
  amountCents Int
  description String
  matchedAt   DateTime?
  createdAt   DateTime  @default(now())

  import       BankImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([importId, matchedAt])
}

// =====================================================================
// Sales / fundraising — see docs/sales-fundraising-design.md.
// Settles into the Treasury ledger via SalesOrder.depositTransaction*.
// =====================================================================

model SalesCampaign {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  startsOn      DateTime
  endsOn        DateTime
  closedAt      DateTime?
  fundId        String
  // "per-scout" splits proceeds to scout-accounts at scoutSplitPct.
  // "whole-unit" keeps everything in the campaign fund.
  proceedsSplit String    @default("per-scout")
  scoutSplitPct Int       @default(70)
  publicSlug    String?   @unique
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org        Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fund       Fund             @relation(fields: [fundId], references: [id], onDelete: Restrict)
  products   SalesProduct[]
  prizes     PrizeTier[]
  orders     SalesOrder[]
  scoutLinks ScoutSalesLink[]
  booths     BoothSale[]

  @@unique([orgId, name])
  @@index([orgId, endsOn])
}

model SalesProduct {
  id            String  @id @default(cuid())
  campaignId    String
  sku           String
  name          String
  priceCents    Int
  unitCostCents Int     @default(0)
  imageUrl      String?
  sortOrder     Int     @default(0)
  archived      Boolean @default(false)

  campaign   SalesCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderItems SalesOrderItem[]

  @@unique([campaignId, sku])
}

model PrizeTier {
  id             String  @id @default(cuid())
  campaignId     String
  thresholdCents Int
  name           String
  description    String?
  sortOrder      Int     @default(0)

  campaign SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ScoutSalesLink {
  id         String   @id @default(cuid())
  campaignId String
  memberId   String
  publicSlug String
  shortUrl   String?
  createdAt  DateTime @default(now())

  campaign SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, memberId])
  @@unique([campaignId, publicSlug])
}

model SalesOrder {
  id                    String    @id @default(cuid())
  orgId                 String
  campaignId            String
  // "scout-personal" | "booth" | "leader-manual" | "public-page"
  source                String
  scoutMemberId         String?
  buyerName             String
  buyerEmail            String?
  buyerPhone            String?
  buyerAddress          String?
  notes                 String?
  // "placed" | "paid" | "delivered" | "cancelled"
  status                String    @default("placed")
  paidAt                DateTime?
  deliveredAt           DateTime?
  totalCents            Int
  stripePaymentIntentId String?
  depositTransactionId  String?   @unique
  refundTransactionId   String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign SalesCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scout    Member?          @relation(fields: [scoutMemberId], references: [id], onDelete: SetNull)
  items    SalesOrderItem[]
  postings Transaction[]

  @@index([orgId, campaignId, createdAt])
  @@index([orgId, scoutMemberId])
  @@index([stripePaymentIntentId])
}

model SalesOrderItem {
  id                String @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  // Running count of how many of this line have been physically
  // handed to the buyer. Treasurers update this as they hand off
  // popcorn / camp-cards. The order surfaces partial-delivery state
  // when 0 < quantityDelivered < quantity.
  quantityDelivered Int    @default(0)
  priceCentsAtOrder Int

  order   SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product SalesProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model BoothSale {
  id             String   @id @default(cuid())
  orgId          String
  campaignId     String
  location       String
  scheduledAt    DateTime
  staffMemberIds String[] @default([])
  totalCents     Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([orgId, campaignId, scheduledAt])
}

// =====================================================================
// Scoutbook read-only sync — see docs/scoutbook-sync-design.md.
// We never write to Scoutbook; this is a derived cache.
// =====================================================================

model ScoutbookConnection {
  id             String    @id @default(cuid())
  orgId          String    @unique
  refreshTokenCt Bytes?
  unitNumber     String?
  councilNumber  String?
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model ScoutbookProfile {
  id              String    @id @default(cuid())
  orgId           String
  memberId        String    @unique
  scoutbookUserId String
  rank            String?
  rankAchievedAt  DateTime?
  serviceHours    Float     @default(0)
  campingNights   Int       @default(0)
  hikingMiles     Float     @default(0)
  // Free-form bag for fields we haven't modelled yet.
  extras          Json      @default("{}")
  syncedAt        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org         Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member      Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meritBadges ScoutbookMeritBadge[]
  awards      ScoutbookAward[]

  @@index([orgId, syncedAt])
}

model ScoutbookMeritBadge {
  id           String    @id @default(cuid())
  profileId    String
  badgeName    String
  status       String
  startedAt    DateTime?
  completedAt  DateTime?
  counselorRef String?

  profile ScoutbookProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeName])
  @@index([profileId, status])
}

model ScoutbookAward {
  id        String    @id @default(cuid())
  profileId String
  awardName String
  awardedAt DateTime?

  profile ScoutbookProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ScoutbookSyncRun {
  id           String    @id @default(cuid())
  orgId        String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  source       String
  rowsSeen     Int       @default(0)
  rowsApplied  Int       @default(0)
  warnings     String[]  @default([])
  errorMessage String?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
}

// =====================================================================
// First-class Locations + Patrols (per design_handoff_compass_cms).
// Locations: meeting halls / camps / outdoor / service / trailhead /
// high adventure. Events optionally reference one (Event.locationId)
// while keeping the free-form `location` + `locationAddress` fields
// for back-compat and ICS feeds.
// Patrols: a row per patrol with a color + leader. Members continue
// to reference patrols by name via the existing `Member.patrol`
// string column for back-compat; this model adds metadata leaders
// can edit without re-keying every Member row.
// =====================================================================

model Location {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  // "Meeting" | "Camp" | "Outdoor" | "Service" | "Trailhead" | "High Adv."
  type          String   @default("Meeting")
  address       String?
  description   String?
  phone         String?
  website       String?
  // Stored as strings to dodge Decimal complexity until we actually
  // need lat/lng math; the leader's input goes straight to the map
  // URL builder.
  lat           String?
  lng           String?
  distanceMiles Float?
  imageUrl      String?
  tags          String[] @default([])
  archived      Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([orgId, name])
  @@index([orgId, archived])
  @@index([orgId, type])
}

model Patrol {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  // Hex (e.g. "#1d3a8a"). Defaults to the editorial accent.
  color          String   @default("#1d3a8a")
  leaderMemberId String?
  description    String?
  archived       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leader Member? @relation("PatrolLeader", fields: [leaderMemberId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId, archived])
}

// Fixed-window rate-limit counters, shared across every app instance.
// One row per bucket key ("v1:ip:<addr>", "v1:user:<id>:write", ...).
// Rows are upserted atomically by src/lib/security/rate-limit.ts and
// swept opportunistically once their window has passed.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Demo deployments only (DEMO_MODE=1, src/lib/demo): every email and
// text the app would have sent, shown on /demo/outbox instead of going
// out. Wiped with the rest of the demo data on each reset.
model DemoOutboxMessage {
  id        String   @id @default(cuid())
  kind      String // email | sms
  to        String
  toName    String?
  subject   String?
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per Stripe webhook effect already applied (src/lib/billing/
// stripe-idempotency.ts). The key names what was applied, e.g.
// "treasury:pi_123" or "event:evt_123", so a payment that arrives as two
// different events, or the same event delivered twice at once, is
// applied once.
model StripeWebhookReceipt {
  key       String   @id
  eventId   String
  eventType String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
