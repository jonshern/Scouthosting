# .dockerignore — anything listed here is NOT included in the build
# context. The Dockerfile builds compass-next/ as the single deploy
# target.

# Build artefacts + deps
node_modules
**/node_modules
**/.next
**/.turbo
**/out
**/dist
**/build

# VCS + IDE
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Agent / project memory not relevant to runtime
.claude
.cursor

# Env files (secrets must come via your orchestrator, not the image)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Top-level docs / planning files
README.md
CLAUDE.md
LICENSE
LICENSE.md
**/MIGRATION_STATUS.md

# Local-only infra
docker-compose.yml
docker-compose.override.yml

# Dev runtime artefacts (uploads belong on a volume / object store)
var
**/var
prisma/dev.db*
*.log

# Mobile + design — not part of the web image
mobile

# Test outputs / scratch
**/test-results
**/playwright-report
**/playwright/.cache
**/coverage
*.tmp
.tmp-*
